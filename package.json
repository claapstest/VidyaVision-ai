{
  "name": "omni2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite --config frontend/vite.config.js",
    "server": "node --watch-path=backend/server.js backend/server.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run server\"",
    "build": "vite build --config frontend/vite.config.js && node scripts/build-backend.js && node scripts/esm-to-cjs.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "lint": "oxlint",
    "build:backend": "node scripts/build-backend.js",
    "build:backend:cjs": "node scripts/esm-to-cjs.js",
    "build:backend:exe": "node scripts/build-sea.js",
    "build:backend:all": "node scripts/build-backend.js && node scripts/esm-to-cjs.js && node scripts/build-sea.js",
    "validate:backend": "powershell -ExecutionPolicy Bypass -File scripts/validate-backend-exe.ps1",
    "package:frontend": "node scripts/package-frontend.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "db:init": "node backend/scripts/init_db.js",
    "db:migrate": "node backend/scripts/migrate_json_to_pg.js",
    "db:test": "node backend/scripts/test_db.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "googleapis": "^174.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "mssql": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
