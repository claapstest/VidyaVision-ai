# Frontend Deployment Base Path (use "/" for root, "/callingbot/" for subpath)
VITE_BASE_PATH=/

# Server & Network Configuration
PORT=5000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# SQL Server Database Connection
MSSQL_HOST=your_sql_server_host
MSSQL_PORT=1433
MSSQL_USER=your_sql_server_username
MSSQL_PASSWORD=your_sql_server_password
MSSQL_DATABASE=vidyavision
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# Telephony Provider (OmniDimension)
OMNIDIM_BASE_URL=https://backend.omnidim.io
OMNIDIM_API_KEY=your_omnidim_api_key_here
AGENT_ID=your_agent_id_here
UG_AGENT_ID=your_ug_agent_id_here
PG_AGENT_ID=your_pg_agent_id_here

# Security & Authentication
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars
WEBHOOK_SECRET=your_webhook_secret_here
APP_API_KEY=your_internal_app_api_key_here

# Logging & Diagnostics
LOG_LEVEL=info
DEBUG_SQL=false

# External Integrations (Optional)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_SERVICE_ACCOUNT_JSON=
WRITE_CACHE_FILE=false
